{
  "name": "ContactRequest",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string",
      "description": "Name of the person enquiring"
    },
    "email": {
      "type": "string",
      "format": "email",
      "description": "Reply address"
    },
    "organization": {
      "type": "string",
      "description": "Company, studio or team"
    },
    "interest": {
      "type": "string",
      "description": "Area of interest selected on the form"
    },
    "message": {
      "type": "string",
      "description": "What the person describes as the situation"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "closed"
      ],
      "default": "new"
    }
  },
  "required": [
    "full_name",
    "email",
    "message"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}